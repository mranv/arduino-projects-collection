# Auto-detect text files and normalize line endings to LF.
* text=auto

# Force LF for source files (keeps diffs clean across platforms).
*.ino    text eol=lf
*.pde    text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf
*.cpp    text eol=lf
*.c      text eol=lf
*.cc     text eol=lf
*.py     text eol=lf
*.swift  text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.ini    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf
*.rs     text eol=lf
*.toml   text eol=lf
*.gradle text eol=lf
*.plist  text eol=lf

# Binary assets (images, schematics, firmware, archives).
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.bmp    binary
*.pdf    binary
*.zip    binary
*.rar    binary
*.aia    binary
*.apk    binary
*.mp3    binary
*.fzz    binary
*.pdsprj binary
*.pwb    binary
*.dsn    text eol=lf
*.sch    text eol=lf
